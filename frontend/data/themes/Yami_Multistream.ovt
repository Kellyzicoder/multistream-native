/* Multistream: the app's own look (dark navy with orange), on top of OBS's Yami theme */

@OBSThemeMeta {
    name: 'Multistream';
    id: 'com.multistream.Dark';
    extends: 'com.obsproject.Yami';
    author: 'Multistream';
    dark: 'true';
}

@OBSThemeVars {
    --grey1: rgb(163,171,196);
    --grey2: rgb(110,118,150);
    --grey3: rgb(44,53,96);
    --grey4: rgb(29,37,70);
    --grey5: rgb(26,33,66);
    --grey6: rgb(16,21,46);
    --grey7: rgb(11,16,38);
    --grey8: rgb(10,14,31);

    --primary: rgb(240,128,30);
    --primary_light: rgb(247,155,74);
    --primary_lighter: rgb(252,190,130);
    --primary_dark: rgb(194,98,15);
    --primary_darker: rgb(120,60,10);

    --bg_base: var(--grey8);
    --bg_window: var(--grey6);
    --bg_preview: rgb(0,0,0);

    --border_color: var(--grey5);

    --input_bg: var(--grey7);
    --input_bg_hover: var(--grey6);
    --input_bg_focus: var(--grey6);

    --list_item_bg_selected: var(--primary);
    --list_item_bg_hover: var(--grey4);

    --input_border: var(--grey3);
    --input_border_hover: var(--primary_light);
    --input_border_focus: var(--primary);

    --button_bg: var(--grey4);
    --button_bg_hover: var(--grey3);
    --button_bg_down: var(--grey5);
    --button_bg_disabled: var(--grey6);

    --button_bg_red: rgb(120,26,34);
    --button_bg_red_hover: rgb(150,34,44);
    --button_bg_red_down: rgb(90,20,26);

    --button_border: var(--grey3);
    --button_border_hover: var(--primary);
    --button_border_focus: var(--primary);

    --tab_bg: var(--input_bg);
    --tab_bg_hover: var(--grey3);
    --tab_bg_down: var(--grey7);
    --tab_bg_disabled: var(--grey6);

    --tab_border: var(--grey3);
    --tab_border_hover: var(--grey1);
    --tab_border_focus: var(--grey1);
    --tab_border_selected: var(--primary);

    --scrollbar_handle: var(--grey3);
    --scrollbar_hover: var(--primary);
    --scrollbar_down: var(--grey4);
    --scrollbar_border: var(--grey5);

    --toolbutton_bg: var(--grey4);
    --toolbutton_bg_hover: var(--primary);
    --toolbutton_bg_down: var(--primary_dark);
    --toolbutton_bg_disabled: var(--grey6);
}

/* Start Streaming: the orange button, as in Multistream */
#streamButton {
    background-color: var(--primary);
    border-color: var(--primary);
    color: #ffffff;
    font-weight: bold;
}

#streamButton:hover {
    background-color: var(--primary_light);
    border-color: var(--primary_light);
}

#streamButton:checked {
    background-color: rgb(210,40,52);
    border-color: rgb(210,40,52);
}

/* ---------- Multistream sidebar and pages ---------- */

#msSidebar {
    background-color: var(--grey7);
    border: none;
    border-right: 1px solid var(--grey5);
    spacing: 0px;
    padding: 0px;
}

#msBrand {
    color: #ffffff;
    font-size: 17px;
    font-weight: bold;
    padding: 4px 8px;
}

QPushButton#msNavButton {
    text-align: left;
    padding: 9px 14px;
    min-width: 170px;
    border: none;
    border-radius: 10px;
    background-color: transparent;
    color: var(--grey1);
    font-size: 14px;
}

QPushButton#msNavButton:hover {
    background-color: var(--grey5);
    color: #ffffff;
}

QPushButton#msNavButton:checked {
    background-color: rgba(240,128,30,0.18);
    color: var(--primary_light);
    font-weight: bold;
}

#msLiveChip {
    padding: 8px;
    border-radius: 10px;
    border: 1px solid var(--grey4);
    color: var(--grey1);
    font-weight: bold;
}

#msLiveChip[live="true"] {
    background-color: rgb(210,40,52);
    border-color: rgb(210,40,52);
    color: #ffffff;
}

#msPages {
    background-color: var(--grey6);
}

#msPageTitle {
    color: #ffffff;
    font-size: 24px;
    font-weight: bold;
}

#msCard {
    background-color: var(--grey7);
    border: 1px solid var(--grey5);
    border-radius: 16px;
}

#msCardTitle {
    color: #ffffff;
    font-size: 15px;
    font-weight: bold;
    padding-bottom: 6px;
}

#msMuted, #msMainChannel {
    color: var(--grey1);
}

#msGoState {
    color: var(--grey1);
    font-weight: bold;
    padding-right: 10px;
}

QPushButton#msGoButton {
    background-color: var(--primary);
    border: none;
    border-radius: 18px;
    color: #ffffff;
    font-weight: bold;
    font-size: 14px;
    padding: 9px 22px;
}

QPushButton#msGoButton:hover {
    background-color: var(--primary_light);
}

QPushButton#msGoButton[live="true"] {
    background-color: rgb(210,40,52);
}

QListWidget#msList {
    background: transparent;
    border: none;
}

QListWidget#msList::item {
    padding: 10px 6px;
    border-bottom: 1px solid var(--grey5);
}
